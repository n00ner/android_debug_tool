<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.apkdbg.cryptofixture"
    android:versionCode="1"
    android:versionName="1.0">
    <application
        android:label="CryptoFixture"
        android:debuggable="true">
        <activity
            android:name=".FixtureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SecondActivity"
            android:exported="false" />
        <receiver
            android:name=".RunReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.apkdbg.cryptofixture.RUN" />
                <action android:name="com.apkdbg.cryptofixture.STRINGS" />
                <action android:name="com.apkdbg.cryptofixture.BENCH" />
                <action android:name="com.apkdbg.cryptofixture.FW_STORE" />
                <action android:name="com.apkdbg.cryptofixture.FW_SVC" />
                <action android:name="com.apkdbg.cryptofixture.FW_BENCH" />
                <action android:name="com.apkdbg.cryptofixture.BUFFERS" />
                <action android:name="com.apkdbg.cryptofixture.UNPACK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
